<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="vivapayments_data" resource="default" engine="innodb" comment="VivaPayments Data Table">
        <column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true" comment="Id"/>
        <column xsi:type="varchar" name="ref" nullable="false" length="255" comment="Reference Id"/>
        <column xsi:type="varchar" name="ordercode" nullable="false" length="255" comment="Order Code"/>
        <column xsi:type="varchar" name="email_address" nullable="false" length="255" comment="Email Address"/>
        <column xsi:type="varchar" name="order_id" nullable="false" length="255" comment="Order Id"/>
        <column xsi:type="decimal" name="total_cost" scale="2" precision="12" unsigned="false" nullable="false"
                default="0" comment="Total Cost"/>
        <column xsi:type="varchar" name="currency" nullable="false" length="255" comment="Currency"/>
        <column xsi:type="varchar" name="order_state" nullable="false" length="255" comment="Order State"/>
        <column xsi:type="datetime" name="timestamp" nullable="false" comment="Payment Date"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>
</schema>
